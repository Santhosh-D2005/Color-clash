{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,

    "jsx": "react-jsx",
    "types": [],
    "paths": {
      /*
       * sharp resolves to the local shim here, never to the installed package.
       * Not cosmetic: sharp's own declarations open with
       * `/// <reference types="node" />`, which drags @types/node into a
       * config whose whole point is `types: []` — so whether this check
       * passed would depend on what happened to be in node_modules. The
       * installed config has no such mapping and uses the real types.
       */
      "sharp": ["./types/sharp-minimal.d.ts"],
      "@colorclash/shared": ["./packages/shared/src/index.ts"],
      "@colorclash/game-content": ["./packages/game-content/src/index.ts"],
      "@colorclash/game-engine": ["./packages/game-engine/src/index.ts"],
      "@colorclash/ai": ["./packages/ai/src/index.ts"],
      "@colorclash/ai/driver": ["./packages/ai/src/driver.ts"],
      "@colorclash/test-fixtures": ["./packages/test-fixtures/src/index.ts"]
    }
  },
  "include": [
    "types/**/*",
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "apps/*/src/**/*",
    "tools/**/*"
  ]
}
